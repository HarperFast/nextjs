{
	"name": "@harperfast/nextjs",
	"version": "1.2.0",
	"type": "module",
	"description": "A Harper plugin for running Next.js apps.",
	"keywords": [
		"harperdb",
		"next.js",
		"distributed",
		"applications"
	],
	"homepage": "https://github.com/HarperFast/nextjs",
	"bugs": {
		"url": "https://github.com/HarperFast/nextjs/issues",
		"email": "support@harperdb.io"
	},
	"author": {
		"name": "HarperDB",
		"email": "support@harperdb.io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HarperFast/nextjs.git"
	},
	"license": "Apache-2.0",
	"files": [
		"config.yaml",
		"dist",
		"schema.graphql"
	],
	"scripts": {
		"format": "prettier .",
		"format:check": "npm run format -- --check",
		"format:fix": "npm run format -- --write",
		"lint": "eslint .",
		"build": "tsc",
		"test:integration": "playwright test --config integrationTests/playwright.config.ts"
	},
	"engines": {
		"node": ">=20"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=22"
		}
	},
	"devDependencies": {
		"@harperfast/integration-testing-framework": "file:../integration-testing-framework",
		"@playwright/test": "^1.52.0",
		"@eslint/js": "9.17.0",
		"@harperdb/code-guidelines": "0.0.6",
		"@types/node": "22.19.11",
		"eslint": "9.17.0",
		"globals": "15.14.0",
		"harper": "file:../harper",
		"next": "15.5.12",
		"prettier": "3.4.2",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"next": "^15.5.12 || ^16.1.6"
	},
	"peerDependenciesMeta": {
		"next": {
			"optional": false
		}
	},
	"prettier": "@harperdb/code-guidelines/prettier"
}
