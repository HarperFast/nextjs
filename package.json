{
	"name": "@harperfast/nextjs",
	"version": "2.0.0",
	"type": "module",
	"description": "A Harper plugin for running Next.js apps.",
	"keywords": [
		"harper",
		"next.js",
		"distributed",
		"applications"
	],
	"homepage": "https://github.com/HarperFast/nextjs",
	"bugs": {
		"url": "https://github.com/HarperFast/nextjs/issues",
		"email": "opensource@harperdb.io"
	},
	"author": {
		"name": "Harper",
		"email": "opensource@harperdb.io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HarperFast/nextjs.git"
	},
	"license": "Apache-2.0",
	"files": [
		"dist",
		"config.yaml",
		"schema.graphql"
	],
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"format": "prettier .",
		"format:check": "npm run format -- --check",
		"format:fix": "npm run format -- --write",
		"build": "tsc -p tsconfig.build.json",
		"test:integration": "playwright test --config integrationTests/playwright.config.ts"
	},
	"engines": {
		"node": ">=20"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=22"
		}
	},
	"devDependencies": {
		"@harperdb/code-guidelines": "0.0.6",
		"@harperfast/integration-testing": "0.2.0",
		"@playwright/test": "1.52.0",
		"@types/node": "22.19.11",
		"harper": "5.0.0",
		"next-14": "npm:next@14.2.35",
		"next-15": "npm:next@15.5.12",
		"next-16": "npm:next@16.2.3",
		"prettier": "3.4.2",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"next": "^14 || ^15 || ^16"
	},
	"peerDependenciesMeta": {
		"next": {
			"optional": false
		}
	},
	"prettier": "@harperdb/code-guidelines/prettier"
}
