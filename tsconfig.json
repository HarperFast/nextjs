{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"lib": ["ES2022"],
		"moduleResolution": "Node16",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"sourceMap": true,
		"outDir": "dist",
		"paths": { "next-build": ["./node_modules/next/dist/build/index.d.ts"] }
	},
	"include": ["plugin.ts"]
}